# logger
LOGGER_LEVEL=debug

# security
JWT_SECRET=admin!@#123
JWT_EXPIRE=86400 
REFRESH_TOKEN_SECRET=admin!@#123
REFRESH_TOKEN_EXPIRE=2592000

# swagger
SWAGGER_ENABLE=true
SWAGGER_PATH=api-docs
SWAGGER_VERSION=1.0
SWAGGER_SERVER_URL=https://william-template.com

# db (PostgreSQL)
# Use 'postgres' for Docker Compose, 'host.docker.internal' for external DB
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=william-template
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=["error"]

# redis
# Use 'redis' for Docker Compose, 'host.docker.internal' for external Redis
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_PASSWORD=123456
REDIS_DB=0

# smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=a@gmail.com
SMTP_PASS=VIP

IS_DEMO=false